    "@remotion/lottie": "4.0.545",
    "@remotion/motion-blur": "4.0.545",
    "@remotion/noise": "4.0.545",
    "@remotion/paths": "^4.0.545",
    "@remotion/sfx": "4.0.545",
    "@remotion/shapes": "^4.0.545",
    "@remotion/three": "4.0.545",
    "@remotion/transitions": "4.0.545",
    "postprocessing": "^6.39.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.545",
    "roughjs": "^4.6.6",
    "simple-icons": "^15.22.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
