{
  "name": "twk-animated-shorts",
  "version": "1.0.0",
  "private": true,
  "description": "Low-token automated 3D-world + 2D-cartoon vertical shorts engine powered by Remotion, Three.js, Fish Audio, Groq Whisper, and GitHub Actions",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "build-check": "tsc --noEmit",
